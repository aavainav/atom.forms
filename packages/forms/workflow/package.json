{
    "name": "@forms/workflow",
    "description": "The workflow package interprets a form's workflow: which transitions it can make now, and what making one changes.",
    "version": "1.0.0",
    "private": true,
    "main": "dist/index.js",
    "module": "dist/index.js",
    "typings": "dist/index.d.ts",
