{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "isolatedModules": true,
        "outDir": "dist",
        "rootDir": "src",
        "strictPropertyInitialization": false,
        // the base config inlines a source map, which for a generated data file would roughly double the
        // emitted size while mapping back to a file nobody edits
        "inlineSourceMap": false,
        "sourceMap": false
    },
    "include": ["src"]
}
