{
    "name": "@forms/audit",
    "description": "The audit package records what happens to a form -- when it is opened, edited, validated, printed and saved -- for a host to keep.",
    "version": "1.0.0",
    "private": true,
    "main": "dist/index.js",
    "module": "dist/index.js",
    "typings": "dist/index.d.ts",
    "type": "module",
    "scripts": {
        "build": "yarn run build-ts",
        "build-ts": "tsc -b .",
        "clean": "rimraf ./dist && rimraf tsconfig.tsbuildinfo",
        "test": "vitest run",
        "test-types": "tsc -p test/tsconfig.json",
        "test-watch": "vitest"
    },
    "dependencies": {
        "@common/event-emitter": "1.0.0",
        "@common/react": "1.0.0",
        "@forms/core": "1.0.0",
        "@shrub/core": "0.5.91"
    }
}
