{
    "name": "@forms/printing",
    "description": "The printing package puts a form onto paper, offering the copies a form declares and the layout they print in.",
    "version": "1.0.0",
    "private": true,
    "main": "dist/index.js",
    "module": "dist/index.js",
    "typings": "dist/index.d.ts",
    "type": "module",
    "scripts": {
        "build": "yarn run build-ts",
        "build-ts": "tsc -b .",
        "clean": "rimraf ./dist && rimraf tsconfig.tsbuildinfo",
        "test": "vitest run",
        "test-types": "tsc -p test/tsconfig.json",
        "test-watch": "vitest"
    },
    "dependencies": {
        "@common/react": "1.0.0",
        "@forms/catalog": "1.0.0",
        "@forms/core": "1.0.0",
        "@forms/report-viewer": "1.0.0",
        "@forms/workbench": "1.0.0",
        "@shrub/core": "0.5.91"
    }
}
