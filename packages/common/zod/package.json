{
    "name": "@common/zod",
    "description": "A shared package for zod schema parsing and validation utilities.",
    "version": "1.0.0",
    "private": true,
    "main": "dist/index.js",
    "module": "dist/index.js",
    "typings": "dist/index.d.ts",
    "type": "module",
    "scripts": {
        "build": "yarn run build-ts",
        "build-ts": "tsc -b .",
        "clean": "rimraf ./dist && rimraf tsconfig.tsbuildinfo",
        "test": "vitest run",
        "test-types": "tsc -p test/tsconfig.json",
        "test-watch": "vitest"
    },
    "dependencies": {
        "zod": "4.3.6"
    }
}